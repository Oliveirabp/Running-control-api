# Copie para .env e ajuste. O arquivo .env NUNCA vai para o Git.

# Banco de dados — SQLite para desenvolvimento rápido; PostgreSQL em produção.
# No Docker Compose esta linha é ignorada: o compose monta a URL do PostgreSQL abaixo.
DATABASE_URL=sqlite:///./running_control.db
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/running_control

# Docker Compose (PostgreSQL). Use uma senha forte — o banco não fica exposto fora do compose.
POSTGRES_DB=running_control
POSTGRES_USER=running
POSTGRES_PASSWORD=
APP_PORT=8000

APP_TIMEZONE=America/Sao_Paulo
SEED_LINES=Linha 1,Linha 2,Linha 3

# Autenticação — gere a chave com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=6

# Primeiro administrador: criado só se o banco não tiver nenhum.
# Depois do primeiro start, apague ADMIN_PASSWORD daqui (ou use: python -m scripts.create_admin).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Alertas escalonados
ENABLE_SCHEDULER=true
CHECK_EVERY_SECONDS=60
APP_BASE_URL=http://localhost:8000

# SMTP — sem SMTP_HOST os e-mails são apenas registrados no log (modo desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=running-control@example.com
SMTP_STARTTLS=true
